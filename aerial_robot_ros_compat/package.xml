<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aerial_robot_ros_compat</name>
  <version>1.3.6</version>
  <description>
    Header-only compatibility layer that lets the aerial robot stack build against
    both roscpp (ROS1) and rclcpp (ROS2) from a single source tree.
  </description>

  <maintainer email="sugihara@jsk.imi.i.u-tokyo.ac.jp">Kazuki Sugihara</maintainer>
  <license>BSD</license>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <!-- installs launch_config.py, which the robots' launch files import -->
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake_python</buildtool_depend>
  <exec_depend condition="$ROS_VERSION == 2">python3-yaml</exec_depend>

  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>

  <!-- used only by the compile test that keeps the two backings in step -->
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>

  <!-- tf1 is used only by the test that checks the replacements against it -->
  <build_depend condition="$ROS_VERSION == 1">eigen_conversions</build_depend>
  <build_depend condition="$ROS_VERSION == 1">tf</build_depend>
  <build_depend condition="$ROS_VERSION == 1">tf_conversions</build_depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
