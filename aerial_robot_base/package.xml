<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aerial_robot_base</name>
  <version>1.3.6</version>
  <description>The base for aerial robots</description>

  <maintainer email="chou@jsk.imi.i.u-tokyo.ac.jp">Bakui Chou</maintainer>
  <license>BSD</license>
  <url type="website">http://wiki.ros.org/beginner_tutorials</url>
  <author email="chou@jsk.imi.i.u-tokyo.ac.jp">Bakui Chou</author>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <!-- installs the ROS2 rewrites of the rospy helpers -->
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake_python</buildtool_depend>

  <depend>aerial_robot_control</depend>
  <depend>aerial_robot_estimation</depend>
  <depend>aerial_robot_model</depend>
  <depend>aerial_robot_ros_compat</depend>
  <depend>pluginlib</depend>

  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <depend condition="$ROS_VERSION == 1">rospy</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <!-- for the ROS2 rewrites of the rospy helpers -->
  <exec_depend condition="$ROS_VERSION == 2">rclpy</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">python3-numpy</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">tf2_ros_py</exec_depend>

  <exec_depend condition="$ROS_VERSION == 1 and $ROS_PYTHON_VERSION == 2">ipython</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1 and $ROS_PYTHON_VERSION == 3">ipython3</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">joy</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">jsk_rviz_plugins</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">mocap_optitrack</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">smach_ros</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">smach_viewer</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">ros_numpy</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rostest</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">ublox_gps</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">ntrip_ros</exec_depend>

  <export>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>

</package>
