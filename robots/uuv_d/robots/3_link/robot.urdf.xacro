  <link name="fc"/>
  <joint name="right" type="revolute">
    <limit effort="10.0" velocity="1.0" lower="-3.14" upper="0.0"/>
    <parent link="link2"/>
    <child link="link1"/>
    <axis xyz="-0.002068    0.          0.99999786"/>
    <origin xyz="0.0 -0.205 -0.06815" rpy="0.0 0.002068 0.0"/>
    <dynamics damping="0.2" friction="0.01"/>
  </joint>
  <joint name="gimbal1" type="revolute">
