    <joint name="rotor5">
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor5">
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rotor_tran6">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotor6">
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor6">
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rotor_tran7">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotor7">
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor7">
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rotor_tran8">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rotor8">
      <hardwareInterface>RotorInterface</hardwareInterface>
    </joint>
    <actuator name="rotor8">
      <hardwareInterface>RotorInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
    <material name="__unnamed_material_1">
    <color rgba="0.75294118 0.75294118 0.75294118 1.        "/>
  </material>

</robot>
