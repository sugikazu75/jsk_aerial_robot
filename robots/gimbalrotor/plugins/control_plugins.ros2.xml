<!-- ROS2 counterpart of control_plugins.xml. Same class, only the library path
     differs: ROS1 pluginlib wants the lib/lib<name> form, while ROS2's
     resolves <name> against the ament index and rejects directory
     components. -->
<library path="gimbalrotor_controller">
  <class name="aerial_robot_control/gimbalrotor_controller" type="aerial_robot_control::GimbalrotorController" base_class_type="aerial_robot_control::ControlBase">
    <description>plugin for gimbalrotor control </description>
  </class>
</library>
