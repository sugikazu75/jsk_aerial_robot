<?xml version="1.0"?>
<!-- A simple scene for the hanging-perching demo of quad_with_dual_arm. Visual only, every part
     is fixed to the task frame env_task (origin on the floor, +z up), placed in "world" at
     (task_x, task_y) turned by task_yaw about z; the planner plans in the task frame (all three 0) and
     uses the visual geometry for collision.

       env_bar    horizontal bar along y at (bar_x, bar_z) to hook the front arm on
       env_posts  the two posts holding the bar
       env_wall   vertical wall whose face is at x = wall_x (facing +x), for the rear arm to touch

     The same arguments are given to this file by plan_perching_motion.py and perching_motion.launch.
     config: a YAML file with bar_x, bar_z, bar_radius, wall_x and task_frame [x, y, yaw]
     (config/quad_with_dual_arm/perching_motion.yaml, that of the planner): its values instead of
     those arguments. -->
<robot name="perching_environment" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="bar_x" default="0.0"/>
  <xacro:arg name="bar_z" default="1.6"/>
  <xacro:arg name="bar_radius" default="0.015"/>
  <xacro:arg name="bar_length" default="1.2"/>
  <xacro:arg name="wall_x" default="-0.6"/>
  <xacro:arg name="task_x" default="0.0"/>
  <xacro:arg name="task_y" default="0.0"/>
  <xacro:arg name="task_yaw" default="0.0"/>
  <xacro:arg name="config" default=""/>
  <!-- the posts drawn: both, left (+y of the task frame) or right (-y), as env_post_left/right of the
       MuJoCo world; one for figures, not to hide the robot behind the near one -->
  <xacro:arg name="posts" default="both"/>
  <xacro:property name="posts" value="$(arg posts)"/>
  <xacro:property name="config" value="$(arg config)"/>
  <xacro:property name="cfg" value="${xacro.load_yaml(config) if config else None}"/>
  <xacro:property name="bar_x" value="${cfg['bar_x'] if config else $(arg bar_x)}"/>
  <xacro:property name="bar_z" value="${cfg['bar_z'] if config else $(arg bar_z)}"/>
  <xacro:property name="bar_radius" value="${cfg['bar_radius'] if config else $(arg bar_radius)}"/>
  <xacro:property name="bar_length" value="$(arg bar_length)"/>
  <xacro:property name="wall_x" value="${cfg['wall_x'] if config else $(arg wall_x)}"/>
  <xacro:property name="task_frame" value="${cfg['task_frame'] if config and 'task_frame' in cfg else [$(arg task_x), $(arg task_y), $(arg task_yaw)]}"/>
  <xacro:property name="wall_thickness" value="0.05"/>
  <xacro:property name="wall_width" value="1.6"/>
  <xacro:property name="wall_height" value="2.4"/>
  <xacro:property name="post_size" value="0.04"/>

  <material name="floor"><color rgba="0.62 0.64 0.63 1"/></material>
  <material name="wall"><color rgba="0.90 0.90 0.87 0.6"/></material>
  <material name="steel"><color rgba="0.70 0.72 0.75 1"/></material>
  <material name="red"><color rgba="0.80 0.13 0.12 1"/></material>

  <link name="world"/>
  <link name="env_task"/>
  <joint name="env_task_joint" type="fixed">
    <parent link="world"/>
    <child link="env_task"/>
    <origin xyz="${task_frame[0]} ${task_frame[1]} 0" rpy="0 0 ${task_frame[2]}"/>
  </joint>

  <link name="env_floor">
    <visual>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="4.0 3.0 0.01"/></geometry>
      <material name="floor"/>
    </visual>
  </link>
  <joint name="env_floor_joint" type="fixed">
    <parent link="env_task"/>
    <child link="env_floor"/>
  </joint>

  <link name="env_bar">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry><cylinder radius="${bar_radius}" length="${bar_length}"/></geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="env_bar_joint" type="fixed">
    <parent link="env_task"/>
    <child link="env_bar"/>
    <origin xyz="${bar_x} 0 ${bar_z}" rpy="0 0 0"/>
  </joint>

  <link name="env_posts">
    <xacro:if value="${posts in ('both', 'left')}">
      <visual>
        <origin xyz="0 ${bar_length/2 + post_size/2} ${-bar_z/2}" rpy="0 0 0"/>
        <geometry><box size="${post_size} ${post_size} ${bar_z + 2*bar_radius}"/></geometry>
        <material name="steel"/>
      </visual>
    </xacro:if>
    <xacro:if value="${posts in ('both', 'right')}">
      <visual>
        <origin xyz="0 ${-bar_length/2 - post_size/2} ${-bar_z/2}" rpy="0 0 0"/>
        <geometry><box size="${post_size} ${post_size} ${bar_z + 2*bar_radius}"/></geometry>
        <material name="steel"/>
      </visual>
    </xacro:if>
  </link>
  <joint name="env_posts_joint" type="fixed">
    <parent link="env_task"/>
    <child link="env_posts"/>
    <origin xyz="${bar_x} 0 ${bar_z}" rpy="0 0 0"/>
  </joint>

  <link name="env_wall">
    <visual>
      <origin xyz="${-wall_thickness/2} 0 ${wall_height/2}" rpy="0 0 0"/>
      <geometry><box size="${wall_thickness} ${wall_width} ${wall_height}"/></geometry>
      <material name="wall"/>
    </visual>
  </link>
  <joint name="env_wall_joint" type="fixed">
    <parent link="env_task"/>
    <child link="env_wall"/>
    <origin xyz="${wall_x} 0 0" rpy="0 0 0"/>
  </joint>
</robot>
