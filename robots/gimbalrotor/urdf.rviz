Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /RobotModel1
        - /Environment1
      Splitter Ratio: 0.5
    Tree Height: 746
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
