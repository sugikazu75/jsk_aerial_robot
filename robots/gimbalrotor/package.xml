<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gimbalrotor</name>
  <version>1.3.2</version>
  <description>The gimbalrotor package</description>

  <maintainer email="chou@jsk.imi.i.u-tokyo.ac.jp">Bakui Chou</maintainer>
  <license>BSD</license>
  <url type="website">https://github.com/jsk-ros-pkg/jsk_aerial_robot</url>
  <author email="j-sugihara@jsk.imi.i.u-tokyo.ac.jp">Junichiro Sugihara</author>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <depend>aerial_robot_control</depend>
  <depend>aerial_robot_estimation</depend>
  <depend>aerial_robot_model</depend>
  <depend>aerial_robot_msgs</depend>
  <depend>aerial_robot_ros_compat</depend>
  <depend>pluginlib</depend>
  <depend>spinal</depend>

  <depend condition="$ROS_VERSION == 1">roscpp</depend>

  <depend condition="$ROS_VERSION == 2">geometry_msgs</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">sensor_msgs</depend>
  <depend condition="$ROS_VERSION == 2">std_msgs</depend>
  <depend condition="$ROS_VERSION == 2">tf2</depend>

  <exec_depend>aerial_robot_base</exec_depend>
  <exec_depend>aerial_robot_simulation</exec_depend>

  <test_depend condition="$ROS_VERSION == 1">rostest</test_depend>

  <export>
    <aerial_robot_model condition="$ROS_VERSION == 1" plugin="${prefix}/plugins/robot_model_plugins.xml" />
    <aerial_robot_control condition="$ROS_VERSION == 1" plugin="${prefix}/plugins/control_plugins.xml" />
    <aerial_robot_control condition="$ROS_VERSION == 1" plugin="${prefix}/plugins/navigation_plugin.xml" />
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>

</package>
