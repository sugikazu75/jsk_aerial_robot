<?xml version="1.0"?>
<launch>
  ###########  launch config  ###########
  <arg name="real_machine" default="True" />
  <arg name="simulation" default="False" />
  <arg name="estimate_mode"  default= "1" />
  <arg name="sim_estimate_mode"  default= "2" />
  <arg name="headless" default="True" />
  <arg name="realtime" default="1.0" />
  <arg name="robot_id" default="" />
  <arg name="robot_ns" value="flying_humanoid$(arg robot_id)" />
  <arg name="config_dir" default="$(find flying_humanoid)/config" />
  <arg name="robot_model" default="$(find flying_humanoid)/robots/flying_humanoid.urdf.xacro" />
  <arg name="mujoco_model" default="$(find flying_humanoid)/mujoco/robot.xml" />
  <arg name="servo_config" default="$(arg config_dir)/Servo.yaml" />
  <!-- False: fly with the gimbalrotor controller, True: walk with the trajectories planned by walk_planner -->
  <arg name="walk" default="False" />

  ###########  Parameters  ###########
  <group ns="$(arg robot_ns)">

    ###########  Basic Param  ###########
    # EGOMOTION_ESTIMATE = 0
    # EXPERIMENT_ESTIMATE = 1. for unstable mocap, use this mode
    # GROUND_TRUTH = 2
    <param name="estimation/mode" value= "$(arg sim_estimate_mode)" if="$(arg simulation)" />
    <param name="estimation/mode" value= "$(arg estimate_mode)" if="$(arg real_machine)"/>

    <param name="uav_model" value= "0" />
    <rosparam file="$(arg config_dir)/RobotModel.yaml" command="load" />

    ###########  Motor Config  ###########
    <rosparam file="$(arg config_dir)/MotorInfo.yaml" command="load" />

    ###########  Servo Config  ###########
    <rosparam file="$(arg servo_config)" command="load" />

    ###########  Battery Config  ###########
    <rosparam file="$(arg config_dir)/Battery.yaml" command="load" />

    ###########  Sensor Fusion  ###########
    <rosparam file="$(arg config_dir)/StateEstimation.yaml" command="load" />
    <rosparam file="$(arg config_dir)/Simulation.yaml" command="load" if="$(eval arg('simulation') and not arg('real_machine'))"/>

    ###########  Control  ###########
    <group unless="$(arg walk)">
      <rosparam file="$(arg config_dir)/Control.yaml" command="load" unless="$(arg simulation)"/>
      <rosparam file="$(arg config_dir)/Control_sim.yaml" command="load" if="$(arg simulation)"/>
      <param name="flight_navigation_plugin_name" value="aerial_robot_navigation/gimbalrotor_navigation"/>
    </group>
    <rosparam file="$(arg config_dir)/WalkControl.yaml" command="load" if="$(arg walk)"/>

    ###########  Navigation  ###########
    <rosparam file="$(arg config_dir)/Navigation.yaml" command="load" />

    ###########  Walk Planner  ###########
    <node pkg="flying_humanoid" type="walk_planner" name="walk_planner" output="screen" if="$(arg walk)">
      <rosparam file="$(arg config_dir)/WalkPlanner.yaml" command="load" />
    </node>

  </group>

  ###########  Base Platform  ###########
  <!-- the tilt flight control closes the attitude loop on this side, so it needs a faster loop -->
  <node pkg="aerial_robot_base" type="aerial_robot_base_node" name="aerial_robot_base_node" ns="$(arg robot_ns)" output="screen">
    <param name="tf_prefix" value="$(arg robot_ns)"/>
    <param name="param_verbose" value="false"/>
    <param name="main_rate" value="200"/>
  </node>

  ###########  Robot Model  ###########
  <include file="$(find aerial_robot_model)/launch/aerial_robot_model.launch" >
    <arg name="headless" value="$(arg headless)" />
    <arg name="robot_model" value="$(arg robot_model)" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="rviz_config" value="$(arg config_dir)/rviz_config" />
    <arg name="rviz_init_pose" value="$(arg config_dir)/RvizInit.yaml" />
    <arg name="need_joint_state" value="false" if ="$(eval arg('simulation') or arg('real_machine'))"/>
  </include>

  ###########  Sensors ###########
  <include file="$(find flying_humanoid)/launch/include/sensors.launch.xml" >
    <arg name="real_machine" value="$(arg real_machine)" />
    <arg name="simulation" value="$(arg simulation)" />
    <arg name="robot_ns" value="$(arg robot_ns)" />
  </include >

  ###########  Servo Bridge  ###########
  <node pkg="aerial_robot_model" type="servo_bridge_node" name="servo_bridge"  output="screen" ns="$(arg robot_ns)"/>

  ########## Simulation in Mujoco #########
  <include file="$(find aerial_robot_simulation)/launch/mujoco.launch" if="$(eval arg('simulation') and not arg('real_machine'))" >
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="headless" value="$(arg headless)"/>
    <arg name="mujoco_model" value="$(arg mujoco_model)"/>
    <arg name="initial_joint_states" value="$(arg servo_config)"/>
    <arg name="mujoco_threads" value="1"/>
  </include>

  <!-- override realtime factor -->
  <group ns="$(arg robot_ns)" if="$(eval arg('simulation') and not arg('real_machine'))">
    <param name="mujoco_server/realtime" value="$(arg realtime)"/>
  </group>

  ########## Restore the initial joint states once the servo controllers are up #########
  <node pkg="flying_humanoid" type="load_initial_joint_states.py" name="load_initial_joint_states"
        ns="$(arg robot_ns)" output="screen"
        if="$(eval arg('simulation') and not arg('real_machine'))"/>

</launch>
