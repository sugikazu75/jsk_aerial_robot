<?xml version="1.0"?>
<package>
  <name>flying_humanoid</name>
  <version>1.3.6</version>
  <description>The flying humanoid with two gimbal rotors, controlled by the gimbalrotor controller</description>

  <maintainer email="sugihara@jsk.imi.i.u-tokyo.ac.jp">Sugihara Kazuki</maintainer>
  <license>BSD</license>
  <url type="website">https://github.com/jsk-ros-pkg/jsk_aerial_robot</url>
  <author email="sugihara@jsk.imi.i.u-tokyo.ac.jp">Sugihara Kazuki</author>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>mujoco_ros_utils</build_depend>
  <build_depend>aerial_robot_control</build_depend>
  <build_depend>aerial_robot_estimation</build_depend>
  <build_depend>aerial_robot_model</build_depend>
  <build_depend>spinal</build_depend>
  <build_depend>std_srvs</build_depend>
  <build_depend>crocoddyl</build_depend>
  <build_depend>eigen</build_depend>
  <build_depend>pinocchio</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>urdfdom</build_depend>

  <run_depend>crocoddyl</run_depend>
  <run_depend>pinocchio</run_depend>
  <run_depend>nav_msgs</run_depend>
  <run_depend>pluginlib</run_depend>
  <run_depend>roscpp</run_depend>
  <run_depend>sensor_msgs</run_depend>
  <run_depend>std_msgs</run_depend>
  <run_depend>urdfdom</run_depend>
  <run_depend>aerial_robot_base</run_depend>
  <run_depend>aerial_robot_control</run_depend>
  <run_depend>aerial_robot_estimation</run_depend>
  <run_depend>aerial_robot_model</run_depend>
  <run_depend>aerial_robot_msgs</run_depend>
  <run_depend>aerial_robot_simulation</run_depend>
  <run_depend>gimbalrotor</run_depend>
  <run_depend>spinal</run_depend>
  <run_depend>controller_manager</run_depend>
  <run_depend>controller_manager_msgs</run_depend>
  <run_depend>effort_controllers</run_depend>
  <run_depend>std_srvs</run_depend>
  <run_depend>rospy</run_depend>
  <run_depend>rosservice</run_depend>
  <run_depend>robot_state_publisher</run_depend>
  <run_depend>rviz</run_depend>
  <run_depend>xacro</run_depend>

  <export>
    <aerial_robot_control plugin="${prefix}/plugins/control_plugins.xml" />
  </export>

</package>
