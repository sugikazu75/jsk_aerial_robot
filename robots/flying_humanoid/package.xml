<?xml version="1.0"?>
<package>
  <name>flying_humanoid</name>
  <version>1.3.6</version>
  <description>The flying humanoid with two gimbal rotors, controlled by the gimbalrotor controller</description>

  <maintainer email="sugihara@jsk.imi.i.u-tokyo.ac.jp">Sugihara Kazuki</maintainer>
  <license>BSD</license>
  <url type="website">https://github.com/jsk-ros-pkg/jsk_aerial_robot</url>
  <author email="sugihara@jsk.imi.i.u-tokyo.ac.jp">Sugihara Kazuki</author>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>mujoco_ros_utils</build_depend>

  <run_depend>aerial_robot_base</run_depend>
  <run_depend>aerial_robot_control</run_depend>
  <run_depend>aerial_robot_estimation</run_depend>
  <run_depend>aerial_robot_model</run_depend>
  <run_depend>aerial_robot_msgs</run_depend>
