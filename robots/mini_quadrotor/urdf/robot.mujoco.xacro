<?xml version="1.0"?>

<!--
    Description used by the ROS2 MuJoCo bringup, the counterpart of
    robot.gazebo.xacro. Same kinematics and inertias; the simulator attachment
    is a <ros2_control> block instead of a <gazebo> plugin tag.
-->

<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="mini_quadrotor" >

  <xacro:arg name="robot_name" default="quadrotor" />

  <!-- robot urdf -->
  <xacro:include filename="$(find mini_quadrotor)/urdf/robot.urdf.xacro" />

  <!-- ros2_control hardware component: the simulated spinal -->
  <xacro:include filename="$(find aerial_robot_simulation)/xacro/spinal.ros2_control.xacro" />
  <xacro:mujoco_spinal rotor_num="4" />

</robot>
