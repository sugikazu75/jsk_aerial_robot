<?xml version="1.0"?>
<launch>
  <arg name="robot_ns" value="quadrotor"/>
  <arg name="headless" value="False"/>
  <arg name="rviz_config" value="$(find mini_quadrotor)/config/rviz_config"/>
  <arg name="lidar" default="False" doc="simulate livox mid360 with mujoco_ros_lidar (run bin/update_mujoco_model.sh once beforehand)" />
  <arg name="lidar_visualize" default="False" doc="draw lidar hit points in the mujoco viewer" />
  <!-- livox mid360 in mujoco: point cloud / imu are published to $(arg robot_ns)/livox/lidar, livox/imu (same topics as the real driver, imu in g) -->
  <arg name="mujoco_lidar_plugin" value="- {type: mujoco_ros_lidar/LidarPlugin, sensors: [{site_attached: lidar, name: livox/lidar, frame_id: $(arg robot_ns)/livox_frame, visualize: $(arg lidar_visualize), imu_site: lidar_imu, imu_name: livox/imu}]}" if="$(arg lidar)" />
  <arg name="mujoco_lidar_plugin" value="" unless="$(arg lidar)" />

  ########## Robot description #########
  <group ns="$(arg robot_ns)">
    <param name="robot_description" command="$(find xacro)/xacro '$(find mini_quadrotor)/urdf/robot.urdf.xacro' robot_name:=$(arg robot_ns)" />
  </group>

  ########## Simulation in Mujoco #########
  <include file="$(find aerial_robot_simulation)/launch/mujoco.launch" >
    <arg name="robot_ns" value="$(arg robot_ns)" />
    <arg name="headless" value="$(arg headless)"/>
    <arg name="mujoco_model" value="$(find mini_quadrotor)/mujoco/robot.xml"/>
    <arg name="use_spinal" value="False"/>
    <arg name="extra_mujoco_plugins" value="$(arg mujoco_lidar_plugin)"/>
  </include>
  <node pkg="tf2_ros" type="static_transform_publisher" name="livox_frame_publisher" ns="$(arg robot_ns)"
        args="-0.011 -0.02329 0.04412 0 0 0 $(arg robot_ns)/lidar_imu $(arg robot_ns)/livox_frame" if="$(arg lidar)" />

  ########## Visualization #########
  <group ns="$(arg robot_ns)">
    <node name="$(anon robot_state_publisher)" pkg="robot_state_publisher" type="robot_state_publisher">
      <param name="tf_prefix" value="$(arg robot_ns)" />
    </node>
    <node name="$(anon rotor_tf_publisher)" pkg="aerial_robot_model" type="rotor_tf_publisher">
      <param name="tf_prefix" value="$(arg robot_ns)" />
    </node>
  </group>

  <group unless="$(arg headless)">
    <node name="$(anon rviz)" pkg="rviz" type="rviz" args="-d $(arg rviz_config)" respawn="true" unless="$(arg headless)"/>
  </group>

</launch>
