<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hydrus</name>
  <version>1.3.6</version>
  <description>The basic packages for hydrus</description>

  <maintainer email="chou@jsk.imi.i.u-tokyo.ac.jp">Bakui Chou</maintainer>
  <license>BSD</license>
  <url type="website">https://github.com/JSKAerialRobot/aerial_robot</url>
  <author email="chou@jsk.imi.i.u-tokyo.ac.jp">Bakui Chou</author>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <depend>aerial_robot_control</depend>
  <depend>aerial_robot_model</depend>
  <depend>aerial_robot_msgs</depend>
  <depend>aerial_robot_ros_compat</depend>
  <depend>spinal</depend>
  <depend>std_srvs</depend>

  <depend condition="$ROS_VERSION == 1">eigen_conversions</depend>
  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <depend condition="$ROS_VERSION == 1">tf_conversions</depend>
  <!-- generates the MuJoCo model from the xacro. A build dependency only under
       ROS1, where it hooks into the build; under ROS2 the generator runs as a
       separate step afterwards, so it is an exec dependency there. -->
  <build_depend condition="$ROS_VERSION == 1">mujoco_ros_utils</build_depend>
  <exec_depend condition="$ROS_VERSION == 2">mujoco_ros_utils</exec_depend>

  <depend condition="$ROS_VERSION == 2">aerial_robot_estimation</depend>
  <depend condition="$ROS_VERSION == 2">pluginlib</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">tf2</depend>

  <exec_depend>aerial_robot_base</exec_depend>
  <exec_depend>aerial_robot_simulation</exec_depend>

  <exec_depend condition="$ROS_VERSION == 2">launch</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">launch_ros</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">mujoco_ros</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">robot_state_publisher</exec_depend>
  <exec_depend condition="$ROS_VERSION == 2">xacro</exec_depend>

  <test_depend condition="$ROS_VERSION == 1">rostest</test_depend>

  <export>
    <aerial_robot_control condition="$ROS_VERSION == 1" plugin="${prefix}/plugins/flight_control_plugins.xml" />
    <aerial_robot_model condition="$ROS_VERSION == 1" plugin="${prefix}/plugins/robot_model_plugins.xml"/>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>

</package>
