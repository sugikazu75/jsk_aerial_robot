<!-- ROS2 counterpart of flight_navigation_plugin.xml. Same class, only the library path
     differs: ROS1 pluginlib wants the lib/lib<name> form, while ROS2's
     resolves <name> against the ament index and rejects directory
     components. -->
<library path="hydrus_xi_under_actuated_navigation">
  <class name="aerial_robot_navigation/hydrus_xi_under_actuated_navigation" type="aerial_robot_navigation::HydrusXiUnderActuatedNavigator" base_class_type="aerial_robot_navigation::BaseNavigator">
    <description> hydrus_xi under-actuated model navigation plugin</description>
  </class>
</library>
