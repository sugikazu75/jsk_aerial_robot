<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hydrus_xi</name>
  <version>1.3.6</version>
  <description>The hydrus_xi package</description>

  <maintainer email="anzai@jsk.imi.i.u-tokyo.ac.jp">Tomoki Anzai</maintainer>

  <license>B.S.D</license>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <depend>aerial_robot_ros_compat</depend>
  <depend>hydrus</depend>
  <!-- both built from source by aerial_robot_3rdparty, under both versions -->
  <depend>nlopt</depend>
  <depend>osqp-eigen</depend>

  <depend condition="$ROS_VERSION == 1">angles</depend>
  <depend condition="$ROS_VERSION == 1">roscpp</depend>
  <!-- regenerates mujoco/*/*/robot.xml; ROS1-only, and the ROS2 build reuses its output -->
  <build_depend condition="$ROS_VERSION == 1">mujoco_ros_utils</build_depend>

  <depend condition="$ROS_VERSION == 2">aerial_robot_control</depend>
  <depend condition="$ROS_VERSION == 2">aerial_robot_estimation</depend>
  <depend condition="$ROS_VERSION == 2">aerial_robot_model</depend>
  <depend condition="$ROS_VERSION == 2">pluginlib</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">sensor_msgs</depend>
  <depend condition="$ROS_VERSION == 2">tf2</depend>

  <exec_depend>aerial_robot_base</exec_depend>
  <exec_depend>aerial_robot_control</exec_depend>
  <exec_depend>aerial_robot_model</exec_depend>
  <exec_depend>aerial_robot_simulation</exec_depend>

  <test_depend condition="$ROS_VERSION == 1">rostest</test_depend>

  <export>
    <aerial_robot_model condition="$ROS_VERSION == 1" plugin="${prefix}/plugins/robot_model_plugin.xml"/>
    <aerial_robot_control condition="$ROS_VERSION == 1" plugin="${prefix}/flight_navigation_plugin.xml" />
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>

</package>
