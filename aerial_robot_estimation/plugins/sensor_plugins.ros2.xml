<!-- ROS2 subset of sensor_plugins.xml.

     Covers the three plugins mini_quadrotor's StateEstimation.yaml actually
     loads. The others are not built for ROS2 yet: gps needs geodesy,
     plane_detection needs jsk_recognition_msgs, alt pulls in the barometer
     bias filter, and optical_flow is a nodelet. None of them are on the path
     to the first milestone.

     The library name also differs from the ROS1 file, which needs the
     lib/lib<name> path form. -->
<library path="sensor_pluginlib">

  <class name="sensor_plugin/imu" type="sensor_plugin::Imu" base_class_type="sensor_plugin::SensorBase">
    <description>IMU sensor plugin.</description>
  </class>

  <class name="sensor_plugin/mocap" type="sensor_plugin::Mocap" base_class_type="sensor_plugin::SensorBase">
    <description>Mocap sensor plugin.</description>
  </class>

  <class name="sensor_plugin/vo" type="sensor_plugin::VisualOdometry" base_class_type="sensor_plugin::SensorBase">
    <description>Visual Odometry sensor plugin.</description>
  </class>

</library>
