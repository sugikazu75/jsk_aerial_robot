<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aerial_robot_estimation</name>
  <version>1.3.6</version>
  <description>The aerial_robot_estimation package</description>

  <maintainer email="chou@jsk.imi.i.u-tokyo.ac.jp">zhao</maintainer>
  <maintainer email="anzai@jsk.imi.i.u-tokyo.ac.jp">anzai</maintainer>
  <license>BSD</license>

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>

  <depend>aerial_robot_model</depend>
  <depend>aerial_robot_msgs</depend>
  <depend>aerial_robot_ros_compat</depend>
  <!-- GeoPoint is on the estimator's public API, which flight_navigation
       calls, so it cannot be conditioned out with the gps plugin. -->
  <depend>geographic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>kalman_filter</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <depend>spinal</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_kdl</depend>
  <depend>tf2_ros</depend>

  <!-- Only needed by the sensor plugins the ROS2 build leaves out: gps
       (geodesy), plane_detection (jsk_recognition_msgs), altitude and the kf
       bias filters (dynamic_reconfigure), optical_flow (nodelet, cv_bridge). -->
  <depend condition="$ROS_VERSION == 1">cv_bridge</depend>
  <depend condition="$ROS_VERSION == 1">dynamic_reconfigure</depend>
  <depend condition="$ROS_VERSION == 1">geodesy</depend>
  <depend condition="$ROS_VERSION == 1">jsk_recognition_msgs</depend>
  <depend condition="$ROS_VERSION == 1">nodelet</depend>
  <depend condition="$ROS_VERSION == 1">tf</depend>
  <depend condition="$ROS_VERSION == 1">tf_conversions</depend>

  <depend condition="$ROS_VERSION == 2">rclcpp</depend>

  <export>
    <kalman_filter condition="$ROS_VERSION == 1" plugin="${prefix}/plugins/kf_plugins.xml" />
    <aerial_robot_estimation condition="$ROS_VERSION == 1" plugin="${prefix}/plugins/sensor_plugins.xml" />
    <nodelet condition="$ROS_VERSION == 1" plugin="${prefix}/plugins/vision_nodelet.xml"/>
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
