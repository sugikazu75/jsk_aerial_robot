<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="empty_underwater">

    <physics name="default_physics" default="true" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <magnetic_field>34 0 -36</magnetic_field>
      <gravity>0 0 -9.8</gravity>
    </physics>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>56.71897669633431</latitude_deg>
      <longitude_deg>3.515625</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
      <shadows>1</shadows>
      <fog>
        <color>1.0 1.0 1.0 0.0</color>
        <type>linear</type>
        <density>0.0</density>
        <start>1000</start>
        <end>2000</end>
      </fog>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="small_ocean_box">
      <static>true</static>
      <link name="link">
        <visual name="ground">
          <cast_shadows>false</cast_shadows>
          <pose>0 0 -10 0 0 0</pose>
          <geometry><box><size>20 20 0.1</size></box></geometry>
          <material>
            <script>
              <uri>file://Media/materials/scripts/sand.material</uri>
              <name>UUVSimulator/SandAndStones</name>
            </script>
          </material>
        </visual>
        <collision name="ground">
          <pose>0 0 -10 0 0 0</pose>
          <geometry><box><size>20 20 0.1</size></box></geometry>
        </collision>

        <!-- <visual name="surface"> -->
        <!--   <cast_shadows>false</cast_shadows> -->
        <!--   <pose>0 0 0 0 0 0</pose> -->
        <!--   <geometry><box><size>20 20 0.1</size></box></geometry> -->
        <!--   <material> -->
        <!--     <script> -->
        <!--       <uri>file://Media/materials/scripts/water.material</uri> -->
        <!--       <name>UUVSimulator/StaticDeepWater</name> -->
        <!--     </script> -->
        <!--   </material> -->
        <!-- </visual> -->

        <visual name="north">
          <cast_shadows>false</cast_shadows>
          <pose>10 0 -5 0 0 0</pose>
          <geometry><box><size>0.1 20 10</size></box></geometry>
          <material>
            <script>
              <uri>file://Media/materials/scripts/water.material</uri>
              <name>UUVSimulator/SeaWall</name>
            </script>
          </material>
        </visual>
        <visual name="south">
          <cast_shadows>false</cast_shadows>
          <pose>-10 0 -5 0 0 0</pose>
          <geometry><box><size>0.1 20 10</size></box></geometry>
          <material>
            <script>
              <uri>file://Media/materials/scripts/water.material</uri>
              <name>UUVSimulator/SeaWall</name>
            </script>
          </material>
        </visual>
        <visual name="east">
          <cast_shadows>false</cast_shadows>
          <pose>0 -10 -5 0 0 0</pose>
          <geometry><box><size>20 0.1 10</size></box></geometry>
          <material>
            <script>
              <uri>file://Media/materials/scripts/water.material</uri>
              <name>UUVSimulator/SeaWall</name>
            </script>
          </material>
        </visual>
        <visual name="west">
          <cast_shadows>false</cast_shadows>
          <pose>0 10 -5 0 0 0</pose>
          <geometry><box><size>20 0.1 10</size></box></geometry>
          <material>
            <script>
              <uri>file://Media/materials/scripts/water.material</uri>
              <name>UUVSimulator/SeaWall</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <plugin name="underwater_current_plugin" filename="libuuv_underwater_current_ros_plugin.so">
      <namespace>hydrodynamics</namespace>
      <constant_current>
        <topic>current_velocity</topic>
        <velocity>
          <mean>0</mean>
          <min>0</min>
          <max>5</max>
          <mu>0.0</mu>
          <noiseAmp>0.0</noiseAmp>
        </velocity>
        <horizontal_angle>
          <mean>0</mean>
          <min>-3.141592653589793238</min>
          <max>3.141592653589793238</max>
          <mu>0.0</mu>
          <noiseAmp>0.0</noiseAmp>
        </horizontal_angle>
        <vertical_angle>
          <mean>0</mean>
          <min>-3.141592653589793238</min>
          <max>3.141592653589793238</max>
          <mu>0.0</mu>
          <noiseAmp>0.0</noiseAmp>
        </vertical_angle>
      </constant_current>
    </plugin>

    <plugin name="sc_interface" filename="libuuv_sc_ros_interface_plugin.so"/>

  </world>
</sdf>
