<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>spinal</name>
  <version>1.3.6</version>
  <description>The spinal package</description>

  <maintainer email="chou@jsk.imi.i.u-tokyo.ac.jp">Bakui Chou</maintainer>
  <license>BSD</license>
  <url type="website">http://wiki.ros.org/beginner_tutorials</url>
  <author email="chou@jsk.imi.i.u-tokyo.ac.jp">Bakui Chou</author>

  <!-- The ROS2 build produces the interfaces only. The rosserial host bridge,
       the rqt GUI plugin and the mcu_project firmware tooling stay ROS1; ROS2
       nodes reach the flight controller through ros1_bridge. -->

  <buildtool_depend condition="$ROS_VERSION == 1">catkin</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">ament_cmake</buildtool_depend>
  <buildtool_depend condition="$ROS_VERSION == 2">rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend condition="$ROS_VERSION == 2">builtin_interfaces</depend>
  <!-- the firmware simulation build (spinal_math, spinal_flight_controller) -->
  <depend condition="$ROS_VERSION == 2">aerial_robot_ros_compat</depend>
  <depend condition="$ROS_VERSION == 2">rclcpp</depend>
  <depend condition="$ROS_VERSION == 2">std_srvs</depend>
  <depend condition="$ROS_VERSION == 2">sensor_msgs</depend>
  <depend condition="$ROS_VERSION == 2">geometry_msgs</depend>

  <build_depend condition="$ROS_VERSION == 1">roscpp</build_depend>
  <build_depend condition="$ROS_VERSION == 1">std_srvs</build_depend>
  <build_depend condition="$ROS_VERSION == 1">message_generation</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rospy</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rqt_gui</build_depend>
  <build_depend condition="$ROS_VERSION == 1">rqt_gui_py</build_depend>

  <exec_depend condition="$ROS_VERSION == 1">roscpp</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">std_srvs</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">message_runtime</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rospy</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rosserial_client</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rosserial_server</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rqt_gui</exec_depend>
  <exec_depend condition="$ROS_VERSION == 1">rqt_gui_py</exec_depend>

  <exec_depend condition="$ROS_VERSION == 2">rosidl_default_runtime</exec_depend>
  <member_of_group condition="$ROS_VERSION == 2">rosidl_interface_packages</member_of_group>

  <export>
    <rqt_gui condition="$ROS_VERSION == 1" plugin="${prefix}/rqt_gui_plugin.xml" />
    <build_type condition="$ROS_VERSION == 1">catkin</build_type>
    <build_type condition="$ROS_VERSION == 2">ament_cmake</build_type>
  </export>
</package>
